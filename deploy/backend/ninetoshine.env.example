# Store the real file at /etc/ninetoshine/ninetoshine.env.
# Do not add it to this repository.
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=*
ConnectionStrings__DefaultConnection="Host=database-host;Port=5432;Database=database-name;Username=database-user;Password=database-password;SSL Mode=VerifyFull"
Firebase__ProjectId=firebase-project-id
